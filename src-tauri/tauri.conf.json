{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Field Medic Manual",
  "version": "../package.json",
  "identifier": "com.gjzkcal.fieldmedicmanual",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm licenses:generate && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Field Medic Manual",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#030303"
      },
      {
        "label": "overlay",
        "title": "Field Medic Manual（小窓）",
        "width": 420,
        "height": 640,
        "minWidth": 320,
        "minHeight": 360,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "gjzkcal",
    "copyright": "Copyright (C) 2026 gjzkcal",
    "shortDescription": "Unofficial manual app for ACE Medical (Arma Reforger)",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": {
      "nsis": {
        "languages": ["Japanese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEREY0QTZCOTU2MDVCRDAKUldUUVcyQ1ZhMHJmZmMrMk1Yc2tsejZaWGxsOWcrWTM4NUVJYTlDaFMwRjlLWGhxSFJmclc2SHcK",
      "endpoints": [
        "https://github.com/gjzkcal/field-medic-manual/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
