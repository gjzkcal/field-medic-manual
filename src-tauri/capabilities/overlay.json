{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Capability for the always-on-top overlay window (least privilege: read, search, favorites, history, settings)",
  "windows": ["overlay"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "allow-search-query",
    "allow-tag-list",
    "allow-doc-get",
    "allow-doc-outline",
    "allow-asset-get",
    "allow-triage-list",
    "allow-triage-get",
    "allow-quickref-list",
    "allow-settings-get",
    "allow-settings-set",
    "allow-fav-toggle",
    "allow-fav-list",
    "allow-history-push",
    "allow-history-list",
    "allow-window-open-in-main",
    "allow-overlay-activate"
  ]
}
