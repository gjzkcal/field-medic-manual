{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:resources:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-client-log",
    "updater:default",
    "process:allow-restart",
    "allow-app-version",
    "allow-doc-upsert",
    "allow-doc-list",
    "allow-doc-get",
    "allow-doc-delete",
    "allow-doc-outline",
    "allow-asset-put",
    "allow-asset-get",
    "allow-search-query",
    "allow-tag-list",
    "allow-synonym-list",
    "allow-synonym-save",
    "allow-synonym-delete",
    "allow-settings-get",
    "allow-settings-set",
    "allow-triage-list",
    "allow-triage-get",
    "allow-triage-upsert",
    "allow-triage-delete",
    "allow-quickref-list",
    "allow-quickref-replace-all",
    "allow-fav-toggle",
    "allow-fav-list",
    "allow-history-push",
    "allow-history-list",
    "allow-hotkey-list",
    "allow-hotkey-set",
    "allow-main-window-ready"
  ]
}
