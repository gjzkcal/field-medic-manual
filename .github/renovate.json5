{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    ':configMigration',
  ],
  dependencyDashboard: {
    enabled: false,
    title: '依存の更新ダッシュボード',
  },
  timezone: 'Asia/Tokyo',
  schedule: [
    'before 9am on monday',
  ],
  minimumReleaseAge: '3 days',
  constraints: {
    pnpm: '11.x',
    node: '26.x',
  },
  osvVulnerabilityAlerts: true,
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 9am on the first day of the month',
    ],
    commitMessageAction: '',
    commitMessageTopic: 'ロックファイルの間接依存を更新',
    commitMessageExtra: '',
  },
  semanticCommits: 'disabled',
  prTitleStrict: true,
  commitMessageAction: '',
  commitMessageTopic: '{{depName}} を',
  commitMessageExtra: '{{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}} に更新',
  group: {
    commitMessageTopic: '{{{groupName}}} を{{#unless commitMessageExtra}}更新{{/unless}}',
  },
  digest: {
    commitMessageTopic: '{{depName}} を',
    commitMessageExtra: '{{newDigestShort}} に更新',
  },
  pin: {
    commitMessageAction: '',
    commitMessageExtra: '{{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}} に固定',
    group: {
      commitMessageTopic: '依存の版を固定',
      commitMessageExtra: '',
    },
  },
  replacement: {
    commitMessageAction: '',
    commitMessageExtra: '{{newName}} {{#if isMajor}}{{{prettyNewMajor}}}{{else}}{{#if isSingleVersion}}{{{prettyNewVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}} に置き換える',
  },
  rollback: {
    commitMessageAction: '',
    commitMessageExtra: '{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{{newValue}}}{{/if}} に戻す',
  },
  vulnerabilityAlerts: {
    commitMessageSuffix: '',
    commitMessageExtra: '{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{{newValue}}}{{/if}}{{/if}} に更新して脆弱性を直す',
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'tool:\\s*(?<depName>cargo-about|cargo-audit)@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'crate',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts/lighthouse\\.ts$/',
      ],
      matchStrings: [
        '"(?<depName>lighthouse)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
        'renovate-config',
        'cargo',
      ],
      commitMessageTopic: '{{depName}} を',
    },
    {
      matchManagers: [
        'rust-toolchain',
      ],
      commitMessageTopic: 'Rust を',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'npm の依存',
      groupSlug: 'npm-deps',
      group: {
        commitMessageTopic: 'npm の依存を{{#unless commitMessageExtra}}更新{{/unless}}',
      },
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Rust の依存',
      groupSlug: 'rust-deps',
      group: {
        commitMessageTopic: 'Rust の依存を{{#unless commitMessageExtra}}更新{{/unless}}',
      },
    },
    {
      matchFileNames: [
        '.github/workflows/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
      group: {
        commitMessageTopic: 'GitHub Actions を{{#unless commitMessageExtra}}更新{{/unless}}',
      },
    },
    {
      matchPackageNames: [
        '@tauri-apps/**',
        'tauri',
        'tauri-build',
        'tauri-plugin-*',
      ],
      groupName: 'Tauri',
      groupSlug: 'tauri',
      group: {
        commitMessageTopic: 'Tauri を{{#unless commitMessageExtra}}更新{{/unless}}',
      },
    },
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'devDependencies',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'oxlint',
        '@eslint-react/**',
        'prettier',
        'prettier-plugin-*',
        'vitest',
        '@testing-library/**',
        'jsdom',
        '@types/**',
        'ajv',
        'shadcn',
      ],
      groupName: '開発用ツール',
      groupSlug: 'dev-tools',
      group: {
        commitMessageTopic: '開発用ツールを{{#unless commitMessageExtra}}更新{{/unless}}',
      },
      automerge: true,
      platformAutomerge: false,
    },
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'typescript',
        '@typescript/native',
        '@typescript/typescript6',
        'oxlint-tsgolint',
      ],
      allowedVersions: '<7.1',
      groupName: 'TypeScript',
      groupSlug: 'typescript',
      group: {
        commitMessageTopic: 'TypeScript を{{#unless commitMessageExtra}}更新{{/unless}}',
      },
      automerge: true,
      platformAutomerge: false,
    },
    {
      matchPackageNames: [
        '@types/node',
      ],
      allowedVersions: '<27',
    },
  ],
}
