{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./triage-flow.v1.schema.json"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "英小文字・数字・ハイフン。ファイル名 <id>.flow.yaml と揃える"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "modTarget": {
      "description": "前提にしている ACE Medical のモジュール",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "core",
          "hitzones",
          "circulation",
          "breathing",
          "defibrillation",
          "ai",
          "general"
        ]
      }
    },
    "modChannel": {
      "description": "ACE の版。省略 = 版を問わない",
      "type": "string",
      "enum": [
        "release",
        "dev"
      ]
    },
    "verifiedAt": {
      "description": "内容を確認した日（YYYY-MM-DD）",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "start": {
      "type": "string",
      "minLength": 1,
      "description": "最初のノードの id"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "question"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "質問"
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "description": "補足（折りたたみで表示）。処置の未確認点は【要確認】と書く"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "ボタンの文言"
                    },
                    "next": {
                      "type": "string",
                      "minLength": 1,
                      "description": "選んだときに進むノードの id"
                    },
                    "tone": {
                      "description": "ボタンの色（yes = 緑、no = 青、danger = 赤）",
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "neutral",
                        "danger"
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "next"
                  ],
                  "additionalProperties": false
                },
                "description": "選択肢（2〜4 個。1〜4 のキーで選ぶ）"
              }
            },
            "required": [
              "type",
              "text",
              "choices"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "action"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "やること"
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "description": "補足（折りたたみで表示）。処置の未確認点は【要確認】と書く"
              },
              "items": {
                "description": "使う物品",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ifMissing": {
                "type": "object",
                "properties": {
                  "next": {
                    "type": "string",
                    "minLength": 1,
                    "description": "持っていないときに進むノードの id"
                  },
                  "label": {
                    "description": "ボタンの文言。省略時は「<items を・でつないだもの>を持っていない」",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "next"
                ],
                "additionalProperties": false,
                "description": "物品を持っていないときの行き先（items があれば必須）"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:doc:([a-z0-9-]+\\.md)(?:#(.+))?|flow:([a-z0-9]+(?:-[a-z0-9]+)*)|quickref:(\\S+)|https:\\/\\/\\S+)$",
                  "description": "doc:<ファイル名>#<アンカー> / flow:<id> / quickref:<id> / https://..."
                },
                "description": "関連ページ"
              },
              "timerSec": {
                "description": "カウントダウンの秒数（CPR のサイクルなど）",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "description": "「次へ」で進むノードの id"
              }
            },
            "required": [
              "type",
              "text",
              "next"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "end"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "結果"
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "description": "補足（折りたたみで表示）。処置の未確認点は【要確認】と書く"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "ok",
                  "warn",
                  "critical"
                ],
                "description": "結果の色（ok = 緑、warn = 黄、critical = 赤）"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:doc:([a-z0-9-]+\\.md)(?:#(.+))?|flow:([a-z0-9]+(?:-[a-z0-9]+)*)|quickref:(\\S+)|https:\\/\\/\\S+)$",
                  "description": "doc:<ファイル名>#<アンカー> / flow:<id> / quickref:<id> / https://..."
                },
                "description": "関連ページ"
              }
            },
            "required": [
              "type",
              "text",
              "outcome"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "subflow"
              },
              "flowId": {
                "type": "string",
                "minLength": 1,
                "description": "呼び出すフローの id"
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "description": "サブフローが end に着いたら戻る先のノードの id"
              }
            },
            "required": [
              "type",
              "flowId",
              "next"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "ノード（キーがノードの id）"
    }
  },
  "required": [
    "$schema",
    "id",
    "title",
    "start",
    "nodes"
  ],
  "additionalProperties": false,
  "title": "トリアージフロー（Field Medic Manual）"
}
