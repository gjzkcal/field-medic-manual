{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./glossary.v1.schema.json"
    },
    "modChannel": {
      "type": "string",
      "enum": [
        "release",
        "dev"
      ],
      "description": "表示名を確かめた ACE の版"
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "表示名を確かめた日（YYYY-MM-DD）"
    },
    "terms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "英小文字・数字・ハイフン。テストの失敗の表示で使う"
          },
          "mod": {
            "type": "string",
            "enum": [
              "reforger",
              "core",
              "circulation",
              "breathing"
            ],
            "description": "表示名を定義している MOD（reforger = ゲーム本体）"
          },
          "kind": {
            "type": "string",
            "enum": [
              "item",
              "action",
              "menu",
              "failReason",
              "notification",
              "state",
              "diagnosis",
              "description",
              "hint"
            ],
            "description": "item = 物品 / action = 操作 / menu = ラジアルメニュー / failReason = 使えない理由 / notification = 通知 / state = 状態 / diagnosis = 診察の表示 / description = 説明文 / hint = ヒント"
          },
          "stringId": {
            "description": "文字列表のキー。prefab に名前を直に書いている物は省く",
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "description": "英語で遊んでいるときの表示"
          },
          "ja": {
            "description": "日本語で遊んでいるときの表示。日本語で出るものにだけ書く",
            "type": "string",
            "minLength": 1
          },
          "manual": {
            "description": "日本語で遊んでいても英語で出るものを、原稿で何と呼ぶか。ja と一緒には書かない",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "mod",
          "kind",
          "en"
        ],
        "additionalProperties": false
      },
      "description": "用語"
    }
  },
  "required": [
    "$schema",
    "modChannel",
    "verifiedAt",
    "terms"
  ],
  "additionalProperties": false,
  "title": "ゲームの表示名の用語集（Field Medic Manual）"
}
