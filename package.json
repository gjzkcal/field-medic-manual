{
  "name": "field-medic-manual",
  "private": true,
  "version": "0.8.0",
  "description": "Unofficial manual app for ACE Medical (Arma Reforger)",
  "license": "GPL-3.0-or-later",
  "author": "gjzkcal",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjzkcal/field-medic-manual.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "build:web": "tsc -b && vite build --mode web",
    "preview:web": "vite preview --mode web",
    "dev:web:lan": "node scripts/web-lan.ts dev",
    "preview:web:lan": "node scripts/web-lan.ts preview",
    "lighthouse:web": "node scripts/lighthouse.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc -b",
    "lint": "tsc -b && oxlint --deny-warnings --report-unused-disable-directives-severity error && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "version:set": "node scripts/set-version.ts",
    "licenses:generate": "node scripts/third-party-licenses.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "temml": "^0.14.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
